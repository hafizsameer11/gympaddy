; Copy to /etc/supervisor/conf.d/gympaddy-queue.conf and adjust paths.
; sudo supervisorctl reread && sudo supervisorctl update && sudo supervisorctl start gympaddy-queue:*

[program:gympaddy-queue]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/gympaddy/artisan queue:work database --queue=default --sleep=3 --tries=2 --timeout=3600 --max-time=3600
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/www/gympaddy/storage/logs/queue-worker.log
stopwaitsecs=3700
